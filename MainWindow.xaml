<Window x:Class="KlingelingFileRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Klingeling File Renamer" Height="600" Width="900"
        PreviewKeyDown="Window_PreviewKeyDown">

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Action">
                <MenuItem Header="_Apply changes..." Click="ApplyChanges_Click" InputGestureText="Ctrl+R" />
                <MenuItem Header="_Refresh..." Click="Refresh_Click" InputGestureText="F5" />
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find/Replace..." Click="Replace_Click" InputGestureText="Ctrl+H" />
                <Separator />
                <MenuItem x:Name="RecordMacroMenuItem" Header="_Start Recording Macro" Click="RecordMacro_Click" InputGestureText="Ctrl+K" />
                <MenuItem Header="_Play Macro" Click="PlayMacro_Click" InputGestureText="Ctrl+M" />
                <Separator />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Klingeling File Renamer" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left column: directory tree -->
                <ColumnDefinition Width="250" MinWidth="150" />
                <!-- Splitter -->
                <ColumnDefinition Width="5" />
                <!-- Right column: editor -->
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: TreeView for directories -->
            <TreeView x:Name="DirectoryTree"
                      Grid.Column="0"
                      SelectedItemChanged="DirectoryTree_SelectedItemChanged" />

            <!-- Resizable splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="LightGray" />

            <!-- AvalonEdit editor. Shows the files of the selected
                 directory as editable text (one file per line).
                 AvalonEdit already provides a find bar via Ctrl+F
                 (appears as overlay top-right in the editor). -->
            <avalonEdit:TextEditor x:Name="EditorBox"
                                    Grid.Column="2"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    ShowLineNumbers="True"
                                    WordWrap="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
